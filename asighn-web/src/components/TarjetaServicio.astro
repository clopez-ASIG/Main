---
/* TarjetaServicio
   Propósito: un servicio en una frase específica y un entregable concreto.
   Anatomía: foto propia en duotono navy con el título encima; abajo la frase, lo que el cliente recibe como oración completa y, si aplica, la cifra de ese servicio. Al pasar, la foto toma color y la cuña amarilla crece.
   Reglas: sin icono genérico. La frase dice qué se mide o se hace, no adjetivos. */
import { getEntry } from 'astro:content';
interface Props { titulo: string; frase: string; entregable: string; href: string; pideFoto: string; foto?: string; cifraId?: string; cifraUnidad?: string }
const { titulo, frase, entregable, href, pideFoto, foto, cifraId, cifraUnidad } = Astro.props;
// Tratamiento F: la cifra junto al servicio que la produjo. El número sale de cifras.json.
const cifra = cifraId ? await getEntry('cifras', cifraId) : undefined;
const numero = cifra ? new Intl.NumberFormat('en-US').format(cifra.data.valor) : undefined;
---
<article class="servicio">
  <div class="servicio__foto" style={foto ? `--foto:url('${foto}')` : undefined}>
    {!foto && <span class="servicio__pide">Foto: {pideFoto}</span>}
    <h3><a href={href}>{titulo}</a></h3>
  </div>
  <div class="servicio__cuerpo">
    <p>{frase}</p>
    <p class="servicio__recibe">{entregable}</p>
    {numero && <p class="servicio__cifra"><b>{numero}</b> {cifraUnidad ?? cifra?.data.unidad}</p>}
  </div>
</article>

<style>
  .servicio { position: relative; background: var(--blanco); display: flex; flex-direction: column; border-bottom: 4px solid var(--azul); transition: border-color .2s ease; }
  .servicio:hover { border-bottom-color: var(--amarillo); }
  .servicio__foto {
    position: relative; aspect-ratio: 3 / 2; overflow: hidden;
    display: flex; flex-direction: column; justify-content: flex-end; padding: var(--e-24);
    background-color: #1E3A68;
    background-image: var(--foto, repeating-linear-gradient(135deg, rgba(255,255,255,.06) 0 14px, transparent 14px 28px));
    background-size: cover; background-position: center; background-blend-mode: luminosity;
  }
  .servicio__foto::before { content: ''; position: absolute; inset: 0; background: var(--navy); opacity: .5; transition: opacity .3s ease; }
  .servicio:hover .servicio__foto::before { opacity: .3; }
  .servicio__foto::after {
    content: ''; position: absolute; top: 0; right: 0; width: 64px; height: 64px;
    background: var(--amarillo); clip-path: polygon(0 0, 100% 0, 100% 100%); transition: width .25s ease, height .25s ease;
  }
  .servicio:hover .servicio__foto::after { width: 88px; height: 88px; }
  .servicio__foto > * { position: relative; z-index: 1; }
  .servicio__pide { position: absolute !important; top: var(--e-16); left: var(--e-16); right: 96px; font-size: var(--t-14); background: var(--blanco); color: var(--gris-texto); padding: var(--e-8); line-height: 1.4; }
  .servicio h3 { margin: 0; font-size: var(--t-22); font-weight: 700; }
  .servicio h3 a { color: var(--blanco); text-decoration: none; }
  .servicio h3 a::after { content: ''; position: absolute; inset: 0; z-index: 2; }
  .servicio__cuerpo { padding: var(--e-24) var(--e-24) var(--e-32); display: flex; flex-direction: column; gap: var(--e-16); flex-grow: 1; }
  .servicio__cuerpo p { margin: 0; color: var(--gris-texto); }
  .servicio__recibe { color: var(--texto) !important; margin-top: auto !important; }
  @media (max-width: 767px) { .servicio__foto { aspect-ratio: 5 / 2; } .servicio__cuerpo { padding: var(--e-16) var(--e-24) var(--e-24); } }
  .servicio__cifra { display: flex; align-items: baseline; gap: var(--e-8); font-size: var(--t-14); color: var(--gris-secundario) !important; border-top: 1px solid var(--borde); padding-top: var(--e-16); }
  .servicio__cifra b { font-family: var(--f-titulo); font-weight: 800; font-size: 30px; line-height: 1; color: var(--azul); font-variant-numeric: lining-nums tabular-nums; }
</style>
