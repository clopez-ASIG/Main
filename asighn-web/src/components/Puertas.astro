---
/* Puertas
   Propósito: la sección más importante del Inicio. Una entrada por visitante, sin nombrarlo como persona.
   Anatomía: tres paneles navy con la esquina amarilla del sitio actual; la frase del visitante en grande, la respuesta de ASIG y un botón.
   Reglas: el visitante se reconoce en la primera línea. Un solo botón por puerta. */
import Boton from './Boton.astro';
interface Puerta { dice: string; respuesta: string; href: string; boton: string }
interface Props { puertas: Puerta[] }
const { puertas } = Astro.props;
---
<ul class="puertas">
  {puertas.map((p) => (
    <li class="puertas__item">
      <p class="puertas__dice">“{p.dice}”</p>
      <p class="puertas__respuesta">{p.respuesta}</p>
      <Boton href={p.href} variante="amarillo">{p.boton}</Boton>
    </li>
  ))}
</ul>

<style>
  .puertas { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--e-16); }
  .puertas__item {
    position: relative;
    background: var(--navy);
    color: var(--blanco);
    padding: var(--e-48) var(--e-32) var(--e-32);
    display: flex; flex-direction: column; align-items: flex-start;
    transition: transform .2s ease;
  }
  .puertas__item::before {
    content: ''; position: absolute; top: 0; right: 0; width: 96px; height: 96px;
    background: var(--amarillo); clip-path: polygon(0 0, 100% 0, 100% 100%);
    transition: width .2s ease, height .2s ease;
  }
  .puertas__item:hover { transform: translateY(-4px); }
  .puertas__item:hover::before { width: 120px; height: 120px; }
  .puertas__dice {
    font-family: var(--f-titulo); font-weight: 700; font-size: var(--t-28); line-height: 1.15;
    color: var(--blanco); margin-bottom: var(--e-24); max-width: 14ch; position: relative;
  }
  .puertas__respuesta { color: var(--borde); flex-grow: 1; margin-bottom: var(--e-32); }
  @media (max-width: 1023px) { .puertas { grid-template-columns: 1fr; } }
</style>
