---
/* Cifras
   Propósito: prueba cuantificada, sin adorno.
   Anatomía: fila de 3 o 4; número Raleway 700 48, unidad Nunito Sans 16 debajo.
   Reglas: sin contador animado. Todo número sale de src/content/cifras.json, que se carga desde el Sheet del canon. */
import { getEntry } from 'astro:content';
interface Props { ids: string[]; sobreNavy?: boolean; titulo?: string; columnas?: number }
const { ids, sobreNavy = false, titulo = 'ASIG en cifras', columnas = ids.length } = Astro.props;
const entradas = await Promise.all(ids.map((id) => getEntry('cifras', id)));
const formato = new Intl.NumberFormat('en-US');
---
<div class={`cifras ${sobreNavy ? 'cifras--navy' : ''}`}>
  <h2 class="visually-hidden">{titulo}</h2>
  <ul style={`--columnas:${columnas}`}>
    {entradas.map((c) => c && (
      <li>
        <span class="cifras__numero">{formato.format(c.data.valor)}</span>
        <span class="cifras__unidad">{c.data.unidad}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .cifras ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--columnas), 1fr); gap: var(--e-32); }
  .cifras li { display: flex; flex-direction: column; gap: var(--e-8); }
  .cifras__numero { font-family: var(--f-titulo); font-weight: 700; font-size: var(--t-48); line-height: 1; color: var(--navy); font-variant-numeric: lining-nums tabular-nums; }
  .cifras__unidad { font-size: var(--t-16); color: var(--gris-texto); max-width: 20ch; }
  .cifras--navy .cifras__numero { color: var(--blanco); }
  .cifras--navy .cifras__unidad { color: var(--borde); }
  @media (max-width: 767px) {
    .cifras ul { grid-template-columns: repeat(min(var(--columnas), 2), 1fr); gap: var(--e-32) var(--e-24); }
  }
</style>
