---
/* Proceso
   Propósito: el método en pasos.
   Anatomía: <ol> sin número visible; el orden lo da la posición. Nombre del paso y una frase.
   Reglas: máximo cinco pasos. Horizontal en escritorio, vertical en móvil. */
interface Paso { nombre: string; frase: string }
interface Props { pasos: Paso[] }
const { pasos } = Astro.props;
---
<ol class="proceso" style={`--n:${pasos.length}`}>
  {pasos.map((p) => (
    <li>
      <h3>{p.nombre}</h3>
      <p>{p.frase}</p>
    </li>
  ))}
</ol>

<style>
  .proceso { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: var(--e-24); counter-reset: none; }
  .proceso li { border-top: 4px solid var(--azul); padding-top: var(--e-24); position: relative; }
  .proceso li:not(:last-child)::after {
    content: ''; position: absolute; top: -4px; right: calc(-1 * var(--e-24)); width: var(--e-24); height: 4px; background: var(--borde);
  }
  .proceso h3 { font-size: var(--t-18); margin-bottom: var(--e-8); }
  .proceso p { color: var(--gris-texto); font-size: var(--t-16); }
  @media (max-width: 1023px) {
    .proceso { grid-template-columns: 1fr; gap: 0; }
    .proceso li { border-top: 0; border-left: 4px solid var(--azul); padding: 0 0 var(--e-24) var(--e-24); }
    .proceso li:not(:last-child)::after { display: none; }
  }
</style>
