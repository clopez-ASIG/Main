---
/* Pilares
   Propósito: los tres pilares del Sello (asig-canon/references/nuestro-sello.md). El sitio es género imagen: aquí sí existe el bloque.
   Anatomía: tres paneles con foto propia en duotono navy y la esquina amarilla; número y nombre del pilar arriba, texto abajo.
   Reglas: el nombre del pilar va tal cual. Un texto que no existe en el Sello o en el sitio actual no se redacta: se pide a Madre. */
import Pendiente from './Pendiente.astro';
interface Pilar { nombre: string; texto: string; pideFoto: string; foto?: string }
interface Props { pilares: Pilar[] }
const { pilares } = Astro.props;
---
<ol class="pilares">
  {pilares.map((p, i) => (
    <li class="pilares__item" style={p.foto ? `--foto:url('${p.foto}')` : undefined}>
      <span class="pilares__num" aria-hidden="true">0{i + 1}</span>
      <h3>{p.nombre}</h3>
      {p.texto ? <p>{p.texto}</p> : <Pendiente texto="texto del pilar; se pide a Madre, no se redacta aquí." />}
      {!p.foto && <span class="pilares__pide">Foto: {p.pideFoto}</span>}
    </li>
  ))}
</ol>

<style>
  .pilares { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--e-16); }
  .pilares__item {
    position: relative; overflow: hidden;
    min-height: 440px;
    padding: var(--e-32);
    display: flex; flex-direction: column; justify-content: flex-end;
    color: var(--blanco);
    background-color: #1E3A68;
    background-image: var(--foto, repeating-linear-gradient(135deg, rgba(255,255,255,.06) 0 14px, transparent 14px 28px));
    background-size: cover; background-position: center;
    background-blend-mode: luminosity;
  }
  .pilares__item::before { content: ''; position: absolute; inset: 0; background: var(--navy); opacity: .72; }
  .pilares__item::after {
    content: ''; position: absolute; top: 0; right: 0; width: 42%; height: 34%;
    background: var(--amarillo); opacity: .85; clip-path: polygon(0 0, 100% 0, 100% 100%);
  }
  .pilares__item > * { position: relative; z-index: 1; }
  .pilares__num { font-family: var(--f-titulo); font-weight: 700; font-size: var(--t-48); line-height: 1; color: var(--amarillo); margin-bottom: auto; font-variant-numeric: lining-nums; }
  .pilares__item h3 { color: var(--blanco); font-size: var(--t-28); font-weight: 700; margin: var(--e-32) 0 var(--e-16); }
  .pilares__item p { color: var(--borde); margin: 0; }
  .pilares__pide { margin-top: var(--e-16); font-size: var(--t-14); background: var(--blanco); color: var(--gris-texto); padding: var(--e-8); line-height: 1.4; }
  @media (max-width: 1023px) { .pilares { grid-template-columns: 1fr; } .pilares__item { min-height: 360px; } }
</style>
