---
/* Hero
   Propósito: la postura de ASIG en pocas palabras, sobre una foto de campo propia.
   Anatomía: foto a pantalla con overlay navy 65 %, titular Raleway 48, subtítulo de una línea, dos botones.
   Reglas: altura al contenido, no 100vh. Dos acciones, nunca tres. Centrado permitido solo aquí y en cierres. */
import Boton from './Boton.astro';
interface Props {
  titulo: string;
  subtitulo: string;
  foto?: string;
  pideFoto: string;
  primario: { href: string; texto: string };
  secundario: { href: string; texto: string };
}
const { titulo, subtitulo, foto, pideFoto, primario, secundario } = Astro.props;
---
<section class="hero" style={foto ? `background-image:url('${foto}')` : undefined}>
  {!foto && <span class="hero__pide">Foto: {pideFoto}</span>}
  <div class="hero__velo"></div>
  <div class="contenedor hero__contenido">
    <h1>{titulo}</h1>
    <p class="hero__sub">{subtitulo}</p>
    <div class="hero__acciones">
      <Boton href={primario.href} variante="navy">{primario.texto}</Boton>
      <Boton href={secundario.href} variante="navy-secundario">{secundario.texto}</Boton>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background-color: var(--navy);
    background-image: repeating-linear-gradient(135deg, #16294a 0 16px, #122340 16px 32px);
    background-size: cover;
    background-position: center;
    color: var(--blanco);
    padding: var(--e-96) 0;
    text-align: center;
  }
  .hero__velo { position: absolute; inset: 0; background: var(--overlay); }
  .hero__pide {
    position: absolute; right: var(--e-16); bottom: var(--e-16); z-index: 2;
    background: var(--blanco); color: var(--gris-texto); font-size: var(--t-14);
    padding: var(--e-8); max-width: 40ch; text-align: left; line-height: 1.4;
  }
  .hero__contenido { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; }
  .hero h1 { color: var(--blanco); max-width: 16ch; margin-bottom: var(--e-24); }
  .hero__sub { font-size: var(--t-18); color: var(--borde); max-width: 52ch; margin-bottom: var(--e-32); }
  .hero__acciones { display: flex; gap: var(--e-16); flex-wrap: wrap; justify-content: center; }
  @media (max-width: 767px) {
    .hero { padding: var(--e-64) 0 var(--e-96); }
  }
</style>
