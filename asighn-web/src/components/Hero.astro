---
/* Hero
   Propósito: la postura de ASIG. El piso es el hero actual de asighn.com: navy, titular en blanco y amarillo, la cuña amarilla detrás de la foto.
   Anatomía: foto de campo a la derecha recortada por la cuña, con la persona midiendo como centro; titular grande a la izquierda con la segunda línea en amarillo; subtítulo; una línea llana que dice qué hace ASIG; dos botones.
   Reglas: altura al contenido. Dos acciones, nunca tres. Foto siempre propia. */
import Boton from './Boton.astro';
interface Props {
  linea1: string;
  linea2: string;
  subtitulo: string;
  llana?: string;
  foto?: string;
  posicionFoto?: string;
  pideFoto: string;
  primario: { href: string; texto: string };
  secundario: { href: string; texto: string };
}
const { linea1, linea2, subtitulo, llana, foto, posicionFoto = 'center', pideFoto, primario, secundario } = Astro.props;
---
<section class="hero">
  <div class="hero__foto" style={foto ? `background-image:url('${foto}');background-position:${posicionFoto}` : undefined}>
    {!foto && <span class="hero__pide">Foto: {pideFoto}</span>}
  </div>
  <div class="hero__cuna" aria-hidden="true"></div>
  <div class="contenedor hero__contenido">
    <h1>{linea1} <span class="amarillo">{linea2}</span></h1>
    <p class="hero__sub">{subtitulo}</p>
    {llana && <p class="hero__llana">{llana}</p>}
    <slot />
    <div class="hero__acciones">
      <Boton href={primario.href} variante="amarillo">{primario.texto}</Boton>
      <Boton href={secundario.href} variante="navy-secundario">{secundario.texto}</Boton>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--navy) var(--reticula) center / 1200px auto;
    background-blend-mode: soft-light;
    color: var(--blanco);
    padding: var(--e-96) 0 calc(var(--e-96) + var(--e-48));
    min-height: 620px;
    display: flex;
    align-items: center;
  }
  /* La foto ocupa la mitad derecha, cortada en diagonal: la cuña es el borde. */
  .hero__foto {
    position: absolute; top: 0; right: 0; bottom: 0; width: 52%;
    background-color: var(--navy-2);
    background-image: repeating-linear-gradient(135deg, rgba(159,176,196,.10) 0 14px, transparent 14px 28px);
    background-size: cover; background-position: center;
    clip-path: polygon(22% 0, 100% 0, 100% 100%, 0 100%);
    filter: grayscale(1) contrast(1.05);
  }
  .hero__foto::after { content: ''; position: absolute; inset: 0; background: var(--navy); opacity: .25; }
  .hero__cuna {
    position: absolute; top: 0; bottom: 0; left: 46%; width: 220px;
    background: var(--amarillo);
    clip-path: polygon(70% 0, 100% 0, 30% 100%, 0 100%);
  }
  .hero__pide {
    position: absolute; right: var(--e-24); bottom: var(--e-24); z-index: 2;
    background: var(--blanco); color: var(--gris-texto); font-size: var(--t-14);
    padding: var(--e-8) var(--e-16); max-width: 38ch; line-height: 1.4;
  }
  .hero__contenido { position: relative; z-index: 1; }
  .hero h1 {
    font-size: var(--t-hero); line-height: 1.02; letter-spacing: -0.015em;
    color: var(--blanco); max-width: 7.2em; margin-bottom: var(--e-32); text-wrap: balance;
  }
  .hero h1 .amarillo { display: block; }
  .hero__sub { font-family: var(--f-titulo); font-weight: 600; font-size: var(--t-22); line-height: 1.35; color: var(--blanco); max-width: 30ch; margin-bottom: var(--e-16); }
  .hero__llana { font-size: var(--t-18); line-height: 1.5; color: var(--borde); max-width: 38ch; margin-bottom: var(--e-32); }
  .hero__acciones { margin-top: var(--e-16); }
  .hero__contenido :global(.pendiente) { max-width: 44ch; }
  .hero__acciones { display: flex; gap: var(--e-16); flex-wrap: wrap; }

  @media (prefers-reduced-motion: no-preference) {
    .hero__cuna { animation: cuna .9s cubic-bezier(.2,.7,.2,1) both .15s; }
    .hero__foto { animation: foto 1.1s ease both; }
    @keyframes cuna { from { transform: translateY(-110%); } to { transform: none; } }
    @keyframes foto { from { opacity: 0; } to { opacity: 1; } }
  }

  @media (max-width: 900px) {
    .hero { flex-direction: column; align-items: stretch; padding: 0 0 var(--e-64); min-height: 0; }
    .hero__foto { position: relative; width: 100%; height: 280px; clip-path: polygon(0 0, 100% 0, 100% 82%, 0 100%); }
    .hero__foto::after { display: none; }
    .hero__cuna { top: 230px; bottom: auto; left: auto; right: 0; width: 100%; height: 64px; clip-path: polygon(0 78%, 100% 0, 100% 30%, 0 100%); }
    .hero__contenido { padding-top: var(--e-48); }
    .hero__sub { font-size: var(--t-18); }
    .hero__llana { font-size: var(--t-16); }
  }
</style>
