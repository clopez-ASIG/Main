---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Cifras from '../components/Cifras.astro';
import Puertas from '../components/Puertas.astro';
import Autodiagnostico from '../components/Autodiagnostico.astro';
import TarjetaServicio from '../components/TarjetaServicio.astro';
import Proceso from '../components/Proceso.astro';
import BandaLogos from '../components/BandaLogos.astro';
import FichaCaso from '../components/FichaCaso.astro';
import TarjetaArticulo from '../components/TarjetaArticulo.astro';
import Cierre from '../components/Cierre.astro';
import Boton from '../components/Boton.astro';
import Pendiente from '../components/Pendiente.astro';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.orden - b.data.orden);
const casoDestacado = (await getCollection('casos')).find((c) => c.data.destacado);
const articulos = (await getCollection('articulos'))
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 3);

const puertas = [
  {
    dice: 'Me pidieron resolver la seguridad y no sé por dónde empezar.',
    respuesta: 'En 30 minutos revisamos con usted qué tiene, qué le falta y por dónde conviene empezar.',
    href: '/diagnostico',
    boton: 'Agendar 30 minutos',
  },
  {
    dice: 'Mi cliente me exige un programa de seguridad.',
    respuesta: 'Envíenos el requisito que le pidieron. Le respondemos con una cotización el mismo día hábil.',
    href: '/contacto',
    boton: 'Cotizar',
  },
  {
    dice: 'Quiero conocer el método antes de recibirlos.',
    respuesta: 'Cómo investigamos, medimos y verificamos, paso por paso y con las fuentes declaradas.',
    href: '/metodologia',
    boton: 'Ver el método',
  },
];

const pasos = [
  { nombre: 'Diagnóstico', frase: 'Entendemos su operación antes de proponer. No llegamos con conclusiones hechas.' },
  { nombre: 'Medición', frase: 'Medimos con equipo calibrado y declaramos la fuente de cada parámetro.' },
  { nombre: 'Hallazgo', frase: 'Cada hallazgo se entrega explicado: de dónde viene, qué efecto tiene y cómo corregirlo.' },
  { nombre: 'Intervención', frase: 'La capacitación cubre lo que la condición no alcanza, diseñada con la realidad de su operación.' },
  { nombre: 'Verificación', frase: 'Una nueva medición confirma que la corrección funcionó.' },
];
---
<Base
  titulo="ASIG Honduras | Seguridad ocupacional, ambiente y sistemas de gestión"
  descripcion="Consultoría en seguridad ocupacional, higiene industrial medible y cultura de seguridad en Honduras. Instrumentos, no diapositivas."
>
  <Hero
    titulo="La seguridad no ocurre por accidente."
    subtitulo="Modernizamos la seguridad ocupacional con instrumentos, no con diapositivas."
    pideFoto="medición en planta, con el instrumento en mano y la operación al fondo (ver docs/fotos.md, foto 1)"
    primario={{ href: '/agenda', texto: 'Agendar 30 minutos' }}
    secundario={{ href: '/contacto', texto: 'Cotizar' }}
  />

  <section class="seccion seccion--cifras">
    <div class="contenedor">
      <Cifras ids={['clientes', 'personas', 'areas', 'informes']} />
    </div>
  </section>

  <section class="seccion seccion--clara entra">
    <div class="contenedor">
      <h2>¿Por dónde empieza usted?</h2>
      <p class="intro">Llegan a ASIG por tres caminos distintos. Elija el que se parezca a su caso.</p>
      <Puertas puertas={puertas} />
      <div class="auto-envoltura">
        <Autodiagnostico />
      </div>
    </div>
  </section>

  <section class="seccion entra">
    <div class="contenedor">
      <h2>Cada servicio declara qué mide y contra qué fuente.</h2>
      <p class="intro">Cuando el reglamento nacional no cubre un parámetro, se declara la fuente supletoria utilizada y por qué aplica a ese caso.</p>
      <div class="grilla-servicios">
        {servicios.map((s) => (
          <TarjetaServicio titulo={s.data.titulo} frase={s.data.frase} entregable={s.data.entregable} href={s.data.slug} pideFoto={s.data.foto} />
        ))}
      </div>
      <p class="enlace-final"><a href="/servicios">Ver todos los servicios</a></p>
    </div>
  </section>

  <section class="seccion seccion--navy flagship entra">
    <div class="contenedor flagship__grilla">
      <div>
        <h2>Su liderazgo y su gente no ven la seguridad igual.</h2>
        <p class="intro">Antes de aplicar el instrumento documentamos lo que su organización hace y escuchamos a los trabajadores. Después medimos en dos niveles, operativo y liderazgo, y leemos uno contra el otro: una brecha entre lo que existe y lo que se percibe es un hallazgo.</p>
        <p class="intro">La Calibración de Percepciones es un instrumento propio de ASIG. Cada medición cierra con su cuadrante: percepción acertada o errónea, procedimiento cumplido o incumplido.</p>
        <Boton href="/medicion-de-cultura" variante="navy-secundario">Conocer la medición</Boton>
      </div>
      <Cifras ids={['respuestas-cultura', 'niveles-cultura', 'rubros-cultura']} sobreNavy titulo="La medición de cultura en cifras" columnas={1} />
    </div>
  </section>

  <section class="seccion entra">
    <div class="contenedor">
      <h2>Primero entendemos, después medimos, al final verificamos.</h2>
      <Pendiente texto="nombres de los pasos del proceso en borrador (pendiente 3)." />
      <Proceso pasos={pasos} />
      <p class="enlace-final"><a href="/metodologia">Ver el método completo</a></p>
    </div>
  </section>

  <section class="seccion seccion--clara entra">
    <div class="contenedor">
      <h2>Clientes atendidos</h2>
      <BandaLogos logos={[]} />
    </div>
  </section>

  {casoDestacado && (
    <section class="seccion entra">
      <div class="contenedor caso-envoltura">
        <h2>Un caso de medición de cultura</h2>
        <FichaCaso {...casoDestacado.data} />
        <p class="enlace-final"><a href="/casos">Ver los casos</a></p>
      </div>
    </section>
  )}

  <section class="seccion seccion--clara entra">
    <div class="contenedor">
      <h2>Ideas que cuestionan las creencias heredadas</h2>
      <div class="grilla-articulos">
        {articulos.map((a) => (
          <TarjetaArticulo
            titulo={a.data.titulo}
            resumen={a.data.resumen}
            portada={a.data.portada}
            href={a.data.rescatado ? `/articulos-y-novedades/${a.id}` : (a.data.urlWix ?? '/articulos-y-novedades')}
            autor={a.data.autor}
            minutos={a.data.minutos}
            fecha={a.data.fecha}
          />
        ))}
      </div>
      <p class="enlace-final"><a href="/articulos-y-novedades">Ver todos los artículos</a></p>
    </div>
  </section>

  <Cierre frase="Respondemos el mismo día." boton={{ href: '/agenda', texto: 'Agendar 30 minutos' }} />
</Base>

<style>
  .seccion--cifras { padding: var(--e-64) 0; border-bottom: 1px solid var(--borde); }
  .auto-envoltura { margin-top: var(--e-48); max-width: 820px; }
  .grilla-servicios { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--e-24); margin-top: var(--e-32); }
  .grilla-articulos { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--e-24); margin-top: var(--e-32); }
  .enlace-final { margin-top: var(--e-32); font-weight: 600; }
  .flagship__grilla { display: grid; grid-template-columns: 3fr 2fr; gap: var(--e-64); align-items: center; }
  .flagship .boton { margin-top: var(--e-16); }
  .caso-envoltura :global(.caso) { max-width: 880px; }
  @media (max-width: 1023px) {
    .grilla-servicios, .grilla-articulos { grid-template-columns: repeat(2, 1fr); }
    .flagship__grilla { grid-template-columns: 1fr; gap: var(--e-48); }
  }
  @media (max-width: 767px) {
    .grilla-servicios, .grilla-articulos { grid-template-columns: 1fr; }
  }
</style>
